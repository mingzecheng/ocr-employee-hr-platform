<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hrplatform.auth.SysUserMapper">
    <resultMap id="SysUserMap" type="com.hrplatform.auth.SysUser">
        <id property="id" column="id" />
        <result property="username" column="username" />
        <result property="passwordHash" column="password_hash" />
        <result property="employeeId" column="employee_id" />
        <result property="departmentId" column="department_id" />
        <result property="enabled" column="enabled" />
        <collection property="roles" ofType="string" column="id" select="findRoles" />
    </resultMap>

    <select id="findByUsername" resultMap="SysUserMap">
        SELECT id, username, password_hash, employee_id, department_id, enabled
        FROM sys_user
        WHERE username = #{username}
        LIMIT 1
    </select>

    <select id="findRoles" resultType="string">
        SELECT r.code
        FROM sys_role r
        JOIN sys_user_role ur ON ur.role_id = r.id
        WHERE ur.user_id = #{id}
        ORDER BY r.code
    </select>
</mapper>
