# Copy this file to infra/.env and replace every change-me value before starting Compose.
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_USERNAME=hr
MYSQL_PASSWORD=change-me-application-password
MYSQL_REPLICATION_USER=repl
MYSQL_REPLICATION_PASSWORD=change-me-replication-password
MYSQL_PRIMARY_PORT=3306
MYSQL_REPLICA_PORT=3307

REDIS_PORT=6379

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

GATEWAY_PORT=8080
IDENTITY_PORT=8081
ARCHIVE_PORT=8082
WORKFLOW_PORT=8083

MYSQL_WRITE_URL=jdbc:mysql://127.0.0.1:3306/identity_db?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
MYSQL_READ_URL=jdbc:mysql://127.0.0.1:3307/identity_db?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
REDIS_HOST=127.0.0.1
REDIS_HOST_PORT=6379
